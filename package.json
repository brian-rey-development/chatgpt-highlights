{
  "name": "chatgpt-highlights",
  "version": "0.1.2",
  "description": "Highlight, annotate and revisit the best parts of your ChatGPT conversations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian-rey-development/chatgpt-highlights.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "icons": "node --experimental-strip-types scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings --diagnostic-level=info .",
    "lint:fix": "biome check --write .",
    "standards": "node scripts/check-standards.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bundle": "pnpm build && node scripts/check-bundle.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-mv3",
    "e2e": "NODE_ENV=production wxt build --mode e2e && playwright test -c e2e/playwright.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm standards && pnpm test",
    "postinstall": "wxt prepare"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@testing-library/jest-dom>@testing-library/dom": "8"
      }
    }
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.9",
    "vitest": "^5.0.4",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
